generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model College {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  location            String
  rating              Float
  fees                Int
  placementPercentage Float
  averagePackage      Float
  highestPackage      Float
  description         String
  campusSize          String
  establishedYear     Int
  accreditation       String
  imageUrl            String
  bannerUrl           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  courses    Course[]
  reviews    Review[]
  // keeping placements for backward compatibility or future granularity, 
  // but adding core stats to College model directly as per prompt.
  placements Placement[] 
  savedBy    SavedCollege[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  savedColleges SavedCollege[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SavedCollege {
  id        String   @id @default(cuid())
  userId    String
  collegeId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
}

model Course {
  id        String   @id @default(uuid())
  name      String
  duration  String
  fees      Int
  seats     Int
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model Review {
  id          String   @id @default(uuid())
  studentName String
  rating      Float
  review      String
  course      String
  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model Placement {
  id          String   @id @default(uuid())
  year        Int
  percentage  Float
  avgPackage  Float
  highestPack Float
  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}
